{
  "name": "dat-movie",
  "version": "1.0.0",
  "description": "Catálogo pessoal de mídia (desktop + mobile web): listas, tiers, episódios, TMDb e Supabase.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ssyigor-cmd/dat-movie.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "test": "node node_modules/vitest/vitest.mjs run",
    "lint": "node node_modules/eslint/bin/eslint.js src tests scripts",
    "check": "npm run lint && npm run test && npm run build",
    "build:favicons": "node scripts/build-favicons.mjs",
    "migrate": "node scripts/migrate-data.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "animejs": "^3.2.1",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^9.39.5",
    "globals": "^14.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
